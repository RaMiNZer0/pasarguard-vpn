# ==============================================================================
# PasarGuard Unified VPN (OpenVPN, IKEv2, L2TP) - Environment Configuration
# ==============================================================================

# 1. PasarGuard Core Integration
# Path to PasarGuard SQLite or PostgreSQL database for real-time user sync
PASARGUARD_DB_URL=sqlite:////opt/pasarguard/data/db.sqlite3

# Origin URL of PasarGuard panel dashboard (for strict CORS policy)
PASARGUARD_PANEL_ORIGIN=https://panel.example.com

# 2. Multi-Node Communication Security
# Pre-shared Bearer token between worker nodes and the master panel
# Generate with: openssl rand -hex 32
PASARGUARD_NODE_API_KEY=replace_with_a_secure_random_64_char_token

# Master Panel URL (used on worker nodes to call auth and accounting APIs)
PASARGUARD_MASTER_URL=https://panel.example.com

# 3. VPN Protocol Credentials & Certificates
# Pre-shared Key for L2TP/IPsec connections
VPN_L2TP_PSK=replace_with_a_strong_l2tp_ipsec_preshared_key

# Directory for CA and server certificates
VPN_CERT_DIR=/opt/pasarguard-vpn/certs

# Data directory for persistent VPN state and cache
PASARGUARD_VPN_DATA_DIR=/var/lib/pasarguard/vpn
